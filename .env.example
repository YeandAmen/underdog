# Credentials are only read by the Go server. Never put them in browser code.
AGENT_ROUTER_API_KEY=
AGENT_ROUTER_BASE_URL=https://agentrouter.org/v1
IDENTITYSHIELD_AI_MODEL=gpt-6.1-sol
IDENTITYSHIELD_AI_PROVIDER=agentrouter
UNDERDOG_AI_BACKEND=opencode

# Connect the repo's Go/OpenCode worker to a hosted workspace. Set the same
# private worker token on both machines; production uses UNDERDOG_AI_BACKEND=worker.
UNDERDOG_WORKER_TOKEN=
UNDERDOG_WORKSPACE_URL=https://underdog-fyield1.vercel.app

# OpenRouter (alternative gateway; use its own key and prefixed model ID):
# IDENTITYSHIELD_AI_PROVIDER=openrouter
# IDENTITYSHIELD_AI_MODEL=openai/gpt-6.1-sol
# IDENTITYSHIELD_AI_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=

# The demo is explicitly labelled synthetic. Disable it for an empty workspace.
IDENTITYSHIELD_DEMO=true
IDENTITYSHIELD_ADDR=127.0.0.1:8787
IDENTITYSHIELD_DATA_DIR=./data

# Optional bearer authentication for collectors or a non-loopback deployment.
IDENTITYSHIELD_ACCESS_TOKEN=

# Explicit opt-in for a public, interactive demo without a workspace login.
IDENTITYSHIELD_PUBLIC_ACCESS=false

# Optional Kaggle credentials, used only for an explicitly requested download.
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional genuinely local LLM mode:
# IDENTITYSHIELD_AI_PROVIDER=ollama
# IDENTITYSHIELD_AI_MODEL=qwen3:8b
# IDENTITYSHIELD_AI_BASE_URL=http://127.0.0.1:11434/v1
